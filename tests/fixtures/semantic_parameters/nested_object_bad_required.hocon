# Error: A nested object property whose required references an undefined
# property. The "address" object defines "street" but requires "city".
# Expected result: 1 error mentioning
# "parameters.properties.address.required" and "undefined props" and "city".
{
    "tools": [
        {
            "name": "agent_a",
            "function": {
                "parameters": {
                    "type": "object",
                    "properties": {
                        "address": {
                            "type": "object",
                            "properties": {
                                "street": {"type": "string"}
                            },
                            "required": ["city"]
                        }
                    }
                }
            },
            "instructions": "test"
        }
    ]
}
