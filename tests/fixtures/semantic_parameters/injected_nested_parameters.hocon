# Error: A tool whose parameters block has a nested 'parameters' key.
# Used by test_bad_parameters to verify the abstract test contract.
# Expected result: at least 1 error.
{
    "tools": [
        {
            "name": "bad_tool",
            "function": {
                "parameters": {
                    "type": "object",
                    "parameters": {
                        "type": "object",
                        "properties": {"x": {"type": "string"}}
                    }
                }
            },
            "instructions": "test"
        }
    ]
}
